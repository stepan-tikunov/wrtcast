config wrtcast 'main'
	# title-api HTTP/JSON gateway
	option api_url 'http://192.168.1.10:50052'
	# Default Chromecast: host[:port], friendly name or device id
	# (see /api/devices); empty = first one found via mDNS
	option cast_host '192.168.1.50'
	# If set, requests must send X-Token header or token parameter
	option token ''
	# Relay HLS playlists, segments and posters through /api/p
	option proxy '1'
	# Upstream User-Agent; must match MOVIE_PROVIDER_USER_AGENT of title-api
	#option user_agent 'Mozilla/5.0 ... CrKey/1.56.500000'
	# Extra upstream headers
	#list header 'Referer: https://example.com/'
	# Base URL the Chromecast uses to reach this router (default: request Host)
	#option public_url 'http://192.168.1.1:8088'
